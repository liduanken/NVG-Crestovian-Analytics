# Copy this file to .env and fill in your values.
#
# Defaults below target Google AI Studio (Gemini) via its OpenAI-compatible
# endpoint. Get a free API key at https://aistudio.google.com/apikey
# Any OpenAI-compatible provider works — swap the three values below.

# Your LLM provider API key (Google AI Studio keys start with "AIza...")
LLM_API_KEY=your_key_here

# Base URL for the chat completions endpoint (OpenAI-compatible)
# Examples:
#   Google AI Studio: https://generativelanguage.googleapis.com/v1beta/openai
#   OpenAI:           https://api.openai.com/v1
#   Anthropic:        https://api.anthropic.com/v1  (with openai-compat header)
#   Azure:            https://<deployment>.openai.azure.com/openai/deployments/<model>
#   Ollama:           http://localhost:11434/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Model name as recognised by your provider
#   Google AI Studio: gemini-3.5-flash  (gemini-3.5-flash-lite is cheaper)
#   OpenAI:           gpt-4o-mini
# Two notes:
#   1. The original default here was `gemma-4-31b-it`, which is not a real model
#      id on any provider. The README also suggests gemini-2.0-flash / 2.5-flash,
#      both of which now return 404 "no longer available" on new keys.
#   2. Pin an explicit version rather than `gemini-flash-latest`. A drifting
#      model silently invalidates eval baselines.
LLM_MODEL=gemini-3.5-flash

# ── Cost control ─────────────────────────────────────────────────────────────
# Per-million-token prices used for budget accounting.
# Verified 2026-08-07 against ai.google.dev/gemini-api/docs/pricing:
#   gemini-3.5-flash        $1.50 in / $9.00 out
#   gemini-3.5-flash-lite   $0.30 in / $2.50 out   (cheaper, still tool-calling)
# Google prices output "including thinking tokens", so reasoning is billed at
# the output rate even when the API reports completion_tokens as 0.
LLM_PRICE_PER_1M_INPUT=1.50
LLM_PRICE_PER_1M_OUTPUT=9.00

# Hard ceiling. Once reached, triage escalates to a human instead of spending.
DAILY_BUDGET_USD=3.00

# ── Agent bounds ─────────────────────────────────────────────────────────────
# Max investigation turns in /resolve. Each turn is at most one LLM call.
MAX_RESOLVE_STEPS=8
# Characters of condensed task log passed to the model per read.
MAX_LOG_CHARS=4000

# Set to false to forbid the agent from editing DAG source entirely.
ALLOW_DAG_PATCHING=true

# ── Airflow ──────────────────────────────────────────────────────────────────
AIRFLOW_URL=http://localhost:8080
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
